---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageType?: string;
  imageWidth?: number;
  imageHeight?: number;
  article?: boolean;
  published?: Date;
  updated?: Date;
  tags?: string[];
}

const {
  title,
  description = "Research, open-source engineering, machine translation, and GPU systems by Marcin Junczys-Dowmunt.",
  image = "/og-default.svg",
  imageType,
  imageWidth,
  imageHeight,
  article = false,
  published,
  updated,
  tags = [],
} = Astro.props;

const pageTitle = title
  ? `${title} | Marcin Junczys-Dowmunt`
  : "Marcin Junczys-Dowmunt";
const socialTitle = title ?? pageTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const authorUrl = new URL("/", Astro.site);
const structuredData =
  article && title && published
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: socialImage.href,
        datePublished: published.toISOString(),
        dateModified: (updated ?? published).toISOString(),
        author: {
          "@type": "Person",
          name: "Marcin Junczys-Dowmunt",
          url: authorUrl.href,
        },
        mainEntityOfPage: canonical.href,
        keywords: tags,
      }
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe4" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Marcin Junczys-Dowmunt" href="/rss.xml" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    {imageType && <meta property="og:image:type" content={imageType} />}
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta property="og:image:alt" content={title ?? "Marcin Junczys-Dowmunt"} />
    {
      article && published && (
        <meta property="article:published_time" content={published.toISOString()} />
      )
    }
    {
      article && updated && (
        <meta property="article:modified_time" content={updated.toISOString()} />
      )
    }
    {article && <meta property="article:author" content={authorUrl} />}
    {
      article &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title ?? "Marcin Junczys-Dowmunt"} />
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
        />
      )
    }
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token":"5465752560f240beaa238b62200b036e"}'
        />
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
