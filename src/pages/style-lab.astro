          <section class="slide" aria-label="System, dark technical">
            <div class="concept-frame terminal">
              <nav class="concept-nav">
                <div class="concept-logo">emjotde</div>
                <ul><li>~/notes</li><li>~/projects</li><li>~/papers</li></ul>
              </nav>
              <div class="concept-content">
