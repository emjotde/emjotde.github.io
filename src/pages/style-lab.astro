          <section class="slide" aria-label="Blueprint, engineered clarity">
            <div class="concept-frame blueprint">
              <nav class="concept-nav">
                <div class="concept-logo">MJD / SYSTEMS</div>
                <ul><li>01 Notes</li><li>02 Work</li><li>03 Papers</li></ul>
              </nav>
              <div class="concept-content">
                <div>
                  <div class="concept-kicker">Drawing 001 / Revision A</div>
                  <h1>Designing useful<br /><span>machine intelligence.</span></h1>
                </div>
                <div class="diagram"><span>MODEL<br />SYSTEM<br />HARDWARE</span></div>
