          <button class="arrow next" type="button" aria-label="Next concept">&rarr;</button>
        </div>
        <div class="concept-tabs" role="tablist" aria-label="Choose a design concept">
          {
            concepts.map((concept, index) => (
              <button
                class="concept-tab"
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                data-index={index}
                data-id={concept.id}
              >
                {concept.number} <span>{concept.name}</span>
              </button>
            ))
          }
        </div>
        <span class="lab-hint">Arrow keys to compare</span>
      </footer>
    </main>

    <script>
      const track = document.querySelector<HTMLElement>(".track");
      const carousel = document.querySelector<HTMLElement>(".carousel");
      const slides = Array.from(document.querySelectorAll<HTMLElement>(".slide"));
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".concept-tab"));
      const position = document.querySelector<HTMLElement>(".lab-position");
      let active = 0;
      let touchStart = 0;

      function show(index: number) {
        active = (index + slides.length) % slides.length;
        if (track && carousel) {
          track.style.transform = `translate3d(-${active * track.clientWidth}px, 0, 0)`;
        }
        tabs.forEach((tab, tabIndex) => {
          tab.setAttribute("aria-selected", String(tabIndex === active));
        });
        slides.forEach((slide, slideIndex) => {
          slide.setAttribute("aria-hidden", String(slideIndex !== active));
        });
        if (position) {
          position.textContent = `${String(active + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
        }
        const id = tabs[active]?.dataset.id;
        if (id) history.replaceState(null, "", `#${id}`);
      }

      document.querySelector(".previous")?.addEventListener("click", () => show(active - 1));
      document.querySelector(".next")?.addEventListener("click", () => show(active + 1));
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => show(Number(tab.dataset.index)));
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") show(active - 1);
        if (event.key === "ArrowRight") show(active + 1);
      });
      track?.addEventListener("touchstart", (event) => {
        touchStart = event.changedTouches[0]?.clientX ?? 0;
      }, { passive: true });
      track?.addEventListener("touchend", (event) => {
        const distance = (event.changedTouches[0]?.clientX ?? 0) - touchStart;
        if (Math.abs(distance) > 50) show(active + (distance < 0 ? 1 : -1));
      }, { passive: true });
      window.addEventListener("resize", () => show(active));
      const requested = tabs.findIndex((tab) => tab.dataset.id === location.hash.slice(1));
      show(requested >= 0 ? requested : 0);
    </script>
  </body>
</html>
