---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const latest = posts[0];
---

<BaseLayout>
  <section class="hero shell">
    <p class="hero-name">Marcin Junczys-Dowmunt</p>
    <h1>Machine translation.<br /><em>Models and systems.</em></h1>
    <div class="hero-grid">
      <div class="hero-intro">
        <p>
          I work with models and language, and sometimes even with language
          models. And just for the heck of it, I am trying to do it all in C++.
        </p>
        <p class="hero-note">
          This site sits somewhere between professional work and hobby
          projects, which is what happens to people who have no real concept of
          work-life balance.
        </p>
      </div>
      <div class="hero-aside">
        <span>Currently</span>
        <p>Head of Research at Microsoft Translator</p>
        <div class="hero-links">
          <a class="text-link" href="https://github.com/emjotde">
            GitHub <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="text-link" href="https://twitter.com/marian_nmt" rel="me">
            Twitter <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="text-link" href="https://www.linkedin.com/in/junczys" rel="me">
            LinkedIn <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="work-cta">
    <div class="shell work-cta-inner">
      <p>Marian: neural machine translation in C++.</p>
      <div class="work-cta-links">
        <a
          class="button-link button-link-primary"
          href="https://github.com/marian-nmt/marian"
        >
          Marian NMT
        </a>
        <a class="button-link" href="/projects/">Other projects</a>
      </div>
    </div>
  </section>

  <section class="feature-band">
    <div class="shell section-grid">
      <div class="section-heading">
        <span class="section-number">01</span>
        <h2>Latest writing</h2>
      </div>
      {latest && (
        <div class="featured-post">
          <PostCard
            title={latest.data.title}
            description={latest.data.description}
            published={latest.data.published}
            slug={latest.id}
            tags={latest.data.tags}
          />
        </div>
      )}
    </div>
  </section>

  <section class="ai-disclaimer shell">
    <h2>AI Disclaimer</h2>
    <p>
      If you suspect that significant parts of this were written by and with
      AI, then you are absolutely right.
    </p>
  </section>

</BaseLayout>
